generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String         @id @default(cuid())
  clerkId                  String         @unique
  email                    String         @unique
  name                     String?
  avatarUrl                String?
  githubId                 String         @unique
  githubUsername           String         @unique
  slug                     String         @unique
  profileStatus            ProfileStatus
  isPublished              Boolean        @default(false)
  publishedAt              DateTime?
  isLeetcodeVerified       Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  featuredProjectsSelected Boolean        @default(false)
  aiInsights               AIInsights?
  analytics                Analytics?
  githubCache              GitHubCache?
  leetcodeCache            LeetCodeCache?
  profile                  Profile?
  repositories             Repository[]

  @@index([githubUsername])
  @@index([slug])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String?
  headline        String?
  bio             String?
  currentRole     String?
  currentCompany  String?
  yearsExperience Int?
  location        String?
  college         String?
  graduationYear  Int?
  techStack       Json?
  linkedinUrl     String?
  portfolioUrl    String?
  resumeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Repository {
  id                   String    @id @default(cuid())
  userId               String
  githubRepoId         String    @unique
  name                 String
  description          String?
  stars                Int
  forks                Int
  primaryLanguage      String?
  topics               Json?
  githubUrl            String
  homepageUrl          String?
  defaultBranch        String    @default("main")
  isFork               Boolean
  isArchived           Boolean
  isFeatured           Boolean   @default(false)
  displayOrder         Int?
  customTitle          String?
  customDescription    String?
  liveDemoUrl          String?
  projectSummary       String?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  githubUpdatedAt      DateTime  @default(now())
  detectedSignals Json?
  detectedTechnologies Json?
  readme               String?   @db.Text
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isFeatured])
  @@index([userId, displayOrder])
}

model GitHubCache {
  id                   String    @id @default(cuid())
  userId               String    @unique
  followers            Int?
  following            Int?
  publicRepoCount      Int?
  totalContributionsLastYear Int?
  contributionCalendar       Json?
  longestStreak        Int?
  activeWeeks          Int?
  ossPrsMerged         Int?
  starsEarned          Int?
  forksEarned          Int?
  languageDistribution Json?
  lastSyncedAt         DateTime?
  cacheExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeetCodeCache {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  username                   String?   @unique
  contestRating              Int?
  percentile                 Float?
  problemsSolved             Int?
  easySolved                 Int?
  mediumSolved               Int?
  hardSolved                 Int?
  contestsParticipated       Int?
  ratingHistory              Json?
  submissionCalendar         Json?
  normalizedSubmissionCalendar Json?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  verifiedAt                 DateTime?
  lastSyncedAt               DateTime?
  cacheExpiresAt             DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  contestGlobalRanking       Int?
  overallRanking             Int?
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analytics {
  id               String    @id @default(cuid())
  userId           String    @unique
  profylScore      Int?
  tier             Tier?
  githubScore      Int?
  projectsScore    Int?
  leetcodeScore    Int?
  consistencyScore Int?
  radar            Json?
  signalBreakdown  Json?
  profylPercentile Float?
  computedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIInsights {
  id            String    @id @default(cuid())
  userId        String    @unique
  aiSignal      String?
  aiSummary     String?
  aiEvidence    String?
  strengthChips Json?
  sourceHash    String?
  promptVersion String?
  modelVersion  String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProfileStatus {
  INCOMPLETE
  DRAFT
  PUBLISHED
}

enum Tier {
  EXCEPTIONAL
  STRONG
  SOLID
  GROWING
}
